# Website / Vercel — copy to .env.local. Never commit secrets.



# Firebase client (safe to expose in the browser)

NEXT_PUBLIC_FIREBASE_API_KEY=

NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=

NEXT_PUBLIC_FIREBASE_PROJECT_ID=repair-series

NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

NEXT_PUBLIC_FIREBASE_APP_ID=

NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=



# Firebase Admin — required for partner assignment, invoices, freeze, notifications.
# Must be a currently valid service-account key for project repair-series.
# Google must accept it (revoked/disabled keys cause 16 UNAUTHENTICATED / 503).
# Never put this JSON in NEXT_PUBLIC_ / EXPO_PUBLIC_ / VITE_ variables.

# Option A: paste the full service account JSON (or base64) in one variable.

FIREBASE_PROJECT_ID=repair-series

FIREBASE_SERVICE_ACCOUNT_JSON=

# Option B (Vercel-friendly): split fields. Private key newlines as \n.

FIREBASE_CLIENT_EMAIL=

FIREBASE_PRIVATE_KEY=



# Cloudinary unsigned browser upload (never add API secret)

NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=



# Cloudinary signed server upload (invoice PDFs and authenticated image uploads).

# Never put API secret in NEXT_PUBLIC_ / VITE_ / EXPO_PUBLIC_.

CLOUDINARY_CLOUD_NAME=

CLOUDINARY_API_KEY=

CLOUDINARY_API_SECRET=



# Optional server integrations

NOTIFY_INTERNAL_SECRET=

RESEND_API_KEY=

RESEND_FROM_EMAIL=

CORS_ALLOWED_ORIGINS=

